# proof-copilot toolchain pins -- the single source of truth.
#
# Read by `pcp setup` (through setup-toolchain.sh, which sources it with `set -a`) and
# by `pcp doctor` / `pcp env` (pcp.util.assets.toolchain_pins, which parses it).
# Plain KEY=VALUE lines only: no quoting, no expansion, no `export`.
# Bumping a pin: edit it here, run `pcp setup`, then `make goldens` (README).

PCP_DEFAULT_OPAM_SWITCH=pcp
PCP_OCAML_VERSION=5.2.1
PCP_ROCQ_VERSION=9.1.1
PCP_ROCQ_STDLIB_VERSION=9.1.0
PCP_COQLSP_VERSION=0.2.5+9.1
PCP_STDPP_VERSION=1.13.0
PCP_IRIS_VERSION=4.5.0
PCP_EQUATIONS_VERSION=1.3.1+9.1

# What pcp *needs* (`pcp doctor` judges a project's own toolchain against these; the
# exact versions above are only the tested default `pcp setup` installs).  Floors, not
# pins: a `dev.*` version counts as newest, and `coq-lsp`'s `+<rocq>` suffix is ignored
# (a git-pinned coq-lsp keeps a stale one).  pytanque speaks coq-lsp 0.2.5's petanque;
# the IPM reflection (coq/IDump.v) was verified on Iris 4.5 and Iris dev 2026-07.
PCP_MIN_ROCQ=9.0
PCP_MIN_COQLSP=0.2.5
PCP_MIN_STDPP=1.11.0
PCP_MIN_IRIS=4.3.0
